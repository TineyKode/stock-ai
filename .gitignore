# Trained models are tracked so they deploy (retrain.yml commits updates).

# Processed data (generated by pipeline). Ignore the contents, not the dir
# itself, so the Kenya slice below can be re-included (git can't un-ignore a
# file whose parent dir is excluded with a trailing slash).
data/processed/*
# ...except the small Kenya slice, which must ship so the deployed app has
# NSE data (US data is fetched live from yfinance; NSE has no live source).
!data/processed/kenya_features.csv

# Logs and feedback
logs/
feedback/

